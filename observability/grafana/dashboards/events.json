{
  "uid": "ha-events",
  "title": "HomeAccounting — Events",
  "tags": ["homeaccounting", "product"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Event throughput by type (events/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (event_type) (rate(events_persisted_total[5m]))",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Write conflicts (conflicts/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(events_write_conflicts_total[5m]))",
          "legendFormat": "conflicts"
        }
      ]
    }
  ]
}
