{
  "uid": "ha-runtime",
  "title": "HomeAccounting — Runtime (GHC)",
  "tags": ["homeaccounting", "runtime"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "description": "GHC RTS metrics. Names follow the backend's Prometheus.Metric.GHC exporter (server-infra Spec 2 / tracker#49); adjust the queries if the exporter uses different names.",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory in use (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ghc_max_mem_in_use_bytes",
          "legendFormat": "max mem in use"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ghc_max_live_bytes",
          "legendFormat": "max live"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Allocation rate (B/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ghc_allocated_bytes_total[5m])",
          "legendFormat": "allocated"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC rate (GCs/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ghc_gcs_total[5m])",
          "legendFormat": "all GCs"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ghc_major_gcs_total[5m])",
          "legendFormat": "major GCs"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GC CPU time (s/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(ghc_gc_cpu_seconds_total[5m])",
          "legendFormat": "gc cpu"
        }
      ]
    }
  ]
}
