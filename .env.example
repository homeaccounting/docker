# HomeAccounting stack — runtime configuration.
#
#   cp .env.example .env   and fill in the four REQUIRED values below.
#
# Everything else has a working default. Values are read by `docker compose`
# and passed to the containers.

# Which service groups run. Every service is profiled, so this MUST be set or
# nothing starts.
#   core          shared TLS edge (caddy)
#   product       the app (api, web)
#   db            the bundled PostgreSQL — drop it to use a managed database
#   observability metrics + logs + dashboards (optional; see the README)
COMPOSE_PROFILES=core,product,db

# ---------------------------------------------------------------- REQUIRED --

# The domain this instance is served on. Caddy obtains a TLS certificate for
# it automatically, so it must already point at this host.
PUBLIC_DOMAIN=accounting.example.com

# Must match PUBLIC_DOMAIN. Used to build OAuth redirect URIs and the Telegram
# webhook URL.
API_BASE_URL=https://accounting.example.com
APP_BASE_URL=https://accounting.example.com

# Database password.                     openssl rand -base64 24
DB_PASSWORD=

# Signs session tokens.                  openssl rand -hex 32
JWT_SECRET=

# Encrypts stored bank-connection tokens. REQUIRED even if you never connect a
# bank — the API refuses to start without it.
#                                        openssl rand -base64 32
# Do NOT change it once banking is in use: stored tokens become undecryptable.
BANKING_TOKEN_ENC_KEY=

# ---------------------------------------------------------------- OPTIONAL --

# Database. The defaults target the bundled `db` profile.
# To use a managed Postgres instead: drop `db` from COMPOSE_PROFILES above and
# point DB_HOST/DB_PORT at it. The API creates its own schema either way.
DB_HOST=postgres
DB_PORT=5432
DB_USER=accounting
DB_NAME=accounting

# Images. Pin the tags for a reproducible deployment.
GHCR_OWNER=homeaccounting
BACKEND_TAG=latest
WEB_TAG=latest

# Only set this if something else terminates TLS in front of Caddy (a cloud
# load balancer, a CDN, an existing reverse proxy). Space-separated CIDRs of
# those proxies; it is what makes the operator IP allowlist see the real client
# address rather than the proxy's. See "Behind an existing proxy" in the README.
# TRUSTED_PROXIES=

# Where the bare domain root sends visitors. Defaults to the app. Set this to
# a marketing site only if the same domain serves one.
# ROOT_REDIRECT=/app/

# Sign-in with Google / GitHub / Microsoft. Register the redirect URI
# ${APP_BASE_URL}/app/auth/oauth/<provider>/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Telegram capture — text the bot and it records transactions.
# Create a bot with @BotFather, then set both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Long-poll timeout in seconds.
# TELEGRAM_POLLING_TIMEOUT=30

# Natural-language entry ("coffee 45, taxi 200"). Calls an external
# OpenAI-compatible endpoint; nothing is self-hosted. A free Groq key works:
# https://console.groq.com
LLM_ENABLED=false
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_MS=20000

# Exchange rates: nbu (National Bank of Ukraine).
EXCHANGE_RATE_PROVIDER=nbu

# debug | info | warn | error
LOG_LEVEL=info

# Normally empty. Comma-separated projection names (or `all`) to replay read
# models at startup; clear it again afterwards or every restart replays the
# whole event log.
REBUILD_READ_MODELS=

# ----------------------------------------------- OBSERVABILITY (optional) --
# Only read when the observability profile is active.

# Grafana is served at grafana.${INTERNAL_DOMAIN}; point an A record for it at
# this host.
INTERNAL_DOMAIN=
# Space-separated CIDRs allowed to reach operator-only vhosts. Everything else
# gets 403. Fail-closed by default — widen it before enabling observability,
# e.g. "203.0.113.4/32".
INTERNAL_ALLOW_IPS=127.0.0.1/32 ::1/128

GRAFANA_ADMIN_USER=admin
# openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d
